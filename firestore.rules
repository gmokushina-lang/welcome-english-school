rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && exists(/databases/$(database)/documents/siteAdmins/$(request.auth.uid))
        && get(/databases/$(database)/documents/siteAdmins/$(request.auth.uid)).data.enabled == true;
    }
    match /siteContent/{version} {
      allow get: if version == 'published' || (version == 'draft' && isOwner());
      allow list: if false;
      allow create, update: if isOwner()
        && version in ['draft', 'published']
        && request.resource.data.keys().hasOnly(['fields', 'updatedAt', 'updatedBy'])
        && request.resource.data.fields is map
        && request.resource.data.fields.size() <= 300
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
